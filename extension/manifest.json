{
  "manifest_version": 3,
  "name": "Cauris — prix en euros",
  "short_name": "Cauris",
  "version": "2.0.0",
  "description": "Affiche l'équivalent en euros à côté des prix en dollars, livres et francs suisses sur toutes les pages.",
  "default_locale": "fr",
  "icons": {"16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png"},
  "action": {"default_popup": "popup.html", "default_icon": {"16": "icones/16.png", "32": "icones/32.png"}},
  "permissions": ["storage"],
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["cauris.js"], "css": ["cauris.css"], "run_at": "document_idle"}]
}
